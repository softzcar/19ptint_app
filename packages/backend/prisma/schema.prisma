generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  admin
  cliente
}

enum EstadoProceso {
  pendiente
  procesando
  listo
  error
  omitido
}

enum TipoJob {
  quitar_fondo
  upscale
}

enum EstadoEntrega {
  pendiente
  entregado
  error
}

enum EstadoJob {
  en_cola
  procesando
  listo
  error
}

enum TipoLienzo {
  dtf
  sublimacion
}

enum FormatoExportacion {
  png
  pdf
  jpeg
}

model Usuario {
  id             Int        @id @default(autoincrement())
  // Se usa tal cual como "nombre y apellido" — así lo pide también el
  // agente de WhatsApp de Ninesys en un solo campo.
  nombre         String     @db.VarChar(100)
  // Opcional desde que existe el login de clientes por teléfono: una cuenta
  // tiene UNO de los dos (nunca ninguno) -- email para admin/staff, telefono
  // para clientes. No son intercambiables: el login de cada uno solo mira
  // su propio campo (ver routes/auth.js).
  email          String?    @unique @db.VarChar(150)
  // E.164 sin '+' (ver lib/telefono.js). Nunca se sincroniza con Ninesys: es
  // la copia congelada del momento en que se le dio acceso a esta app, no
  // una réplica en vivo de sus datos de cliente.
  telefono       String?    @unique @db.VarChar(20)
  password_hash  String     @db.VarChar(255)
  rol            Rol        @default(cliente)
  activo         Boolean    @default(true)
  // null = sin límite. Cuenta quitar_fondo + upscale disparados hoy (CONTEXTO.md
  // no lo pedía, pero es la métrica que más se relaciona con el costo real: CPU).
  limite_diario  Int?
  // Datos para el pedido por WhatsApp a Ninesys (ver §15 de CONTEXTO.md).
  // Opcionales hasta que el cliente los completa en su perfil.
  cedula         String?    @db.VarChar(20)
  direccion      String?    @db.VarChar(255)
  created_at     DateTime   @default(now())
  proyectos      Proyecto[]

  @@map("usuarios")
}

model Proyecto {
  id         Int       @id @default(autoincrement())
  usuario_id Int
  nombre     String?   @db.VarChar(150)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  usuario    Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  imagenes   Imagen[]
  lienzos    Lienzo[]
  dtf_uv     DtfUv[]

  @@map("proyectos")
}

model Imagen {
  id               Int           @id @default(autoincrement())
  proyecto_id      Int
  nombre_original  String?       @db.VarChar(255)
  ruta_original    String?       @db.VarChar(500)
  ruta_procesada   String?       @db.VarChar(500)
  ancho_px         Int?
  alto_px          Int?
  dpi              Int           @default(300)
  ancho_mm         Decimal?      @db.Decimal(8, 2)
  alto_mm          Decimal?      @db.Decimal(8, 2)
  // Nace en 1 para no obligar a tocar el campo en el caso común (una copia).
  // Sigue siendo editable por el usuario, incluido bajarlo a 0 -- eso sigue
  // bloqueando el acomodo hasta que lo corrija (0 copias = el motor de
  // empaquetado no genera ninguna pieza para ella, ver packing-engine).
  copias           Int           @default(1)
  estado_fondo     EstadoProceso @default(pendiente)
  // Preferencia del usuario, independiente de estado_fondo (que es el
  // estado del PROCESO): true = se quitó/se va a quitar el fondo con IA,
  // false = se revirtió a propósito y ruta_procesada apunta a ruta_original
  // tal cual (ver POST /imagenes/:id/mantener-fondo).
  quitar_fondo     Boolean       @default(true)
  estado_upscale   EstadoProceso @default(omitido)
  // Apunta al archivo de ruta_procesada de justo ANTES del último upscale
  // aplicado -- permite deshacerlo si el resultado sale mal (ver POST
  // /imagenes/:id/revertir-upscale). Null cuando no hay upscale para
  // deshacer (nunca se corrió uno, o ya se revirtió).
  ruta_pre_upscale String?       @db.VarChar(500)
  created_at       DateTime      @default(now())
  proyecto         Proyecto      @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  jobs             Job[]
  lienzo_items     LienzoItem[]

  @@map("imagenes")
}

model Job {
  id             Int       @id @default(autoincrement())
  imagen_id      Int
  tipo           TipoJob
  estado         EstadoJob @default(en_cola)
  mensaje_error  String?   @db.Text
  creado_en      DateTime  @default(now())
  iniciado_en    DateTime?
  terminado_en   DateTime?
  imagen         Imagen    @relation(fields: [imagen_id], references: [id], onDelete: Cascade)

  @@map("jobs")
}

model Lienzo {
  id                   Int                @id @default(autoincrement())
  proyecto_id          Int
  tipo                 TipoLienzo
  ancho_mm             Decimal            @db.Decimal(8, 2)
  margen_mm            Decimal            @default(5) @db.Decimal(6, 2)
  alto_usado_mm        Decimal?           @db.Decimal(10, 2)
  formato_exportacion  FormatoExportacion
  ruta_export          String?            @db.VarChar(500)
  // Tela que trae/pide el cliente -- solo tiene sentido para sublimación
  // (DTF no lleva este detalle). Texto libre porque no hay un catálogo
  // cerrado de telas: se escribe al subir el lienzo y viaja como detalle
  // del producto al crear el presupuesto en Ninesys (campo `tela`, hasta
  // ahora siempre "No aplica").
  tela                 String?            @db.VarChar(255)
  created_at           DateTime           @default(now())
  proyecto             Proyecto           @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  items                LienzoItem[]
  // Presupuesto real creado en Ninesys al enviar el pedido por WhatsApp
  // (CONTEXTO.md §15/§16) -- null hasta que se envía. Evita reenvíos
  // duplicados y permite mostrar el estado en la UI del lienzo.
  id_presupuesto_ninesys Int?
  id_empresa_ninesys     Int?
  // Copia del cliente y la fecha al confirmar el pedido. Se guardan acá (y no
  // se consultan a Ninesys al momento de entregar) por dos razones: el nombre
  // del archivo que baja a la PC de producción se arma con estos datos, y no
  // queremos que esa ruta dependa de que Ninesys responda; y además el nombre
  // debe quedar congelado tal como se cotizó, aunque después alguien corrija
  // la ficha del cliente.
  cliente_nombre         String?   @db.VarChar(100)
  cliente_apellido       String?   @db.VarChar(100)
  // Copia local estructurada -- PENDIENTE DE SINCRONIZAR con el contrato
  // real de Ninesys para estos 3 campos (ver crearCliente() en
  // lib/ninesysApi.js). Se guardan tal cual mientras tanto, además de
  // plegarse como texto legible en la dirección que sí llega a Ninesys hoy.
  cliente_pais           String?   @db.VarChar(100)
  cliente_estado         String?   @db.VarChar(100)
  cliente_ciudad         String?   @db.VarChar(100)
  pedido_en              DateTime?
  // Entrega a la PC de producción de la empresa -- se crea al confirmar el
  // pedido, junto con id_empresa_ninesys.
  entrega                EntregaLienzo?

  @@map("lienzos")
}

model LienzoItem {
  id         Int      @id @default(autoincrement())
  lienzo_id  Int
  imagen_id  Int
  x_mm       Decimal? @db.Decimal(10, 2)
  y_mm       Decimal? @db.Decimal(10, 2)
  ancho_mm   Decimal? @db.Decimal(8, 2)
  alto_mm    Decimal? @db.Decimal(8, 2)
  rotacion   Int      @default(0) @db.SmallInt
  orden      Int?
  lienzo     Lienzo   @relation(fields: [lienzo_id], references: [id], onDelete: Cascade)
  imagen     Imagen   @relation(fields: [imagen_id], references: [id], onDelete: Cascade)

  @@map("lienzo_items")
}

// Diseño DTF UV: logo/imagen subida -> vectorizada -> propuesta automática
// de máscaras blanco/barniz (sliders, sin IA generativa) -> editadas a mano
// -> exportadas con separaciones spot reales. No usa la tabla `Job` (que es
// imagen_id-scoped) -- sigue el mismo patrón que Lienzo/EntregaLienzo: cada
// etapa async (vectorizado, capas, export) trackea su estado en columnas
// propias. Ver /Users/ricardo/.claude/plans/witty-napping-origami.md.
model DtfUv {
  id                   Int           @id @default(autoincrement())
  proyecto_id          Int
  nombre_original      String?       @db.VarChar(255)
  ruta_original        String?       @db.VarChar(500)
  ruta_vector          String?       @db.VarChar(500) // SVG vectorizado (vtracer)
  ruta_silueta         String?       @db.VarChar(500) // PNG limpio rasterizado desde el SVG
  estado_vectorizado   EstadoProceso @default(pendiente)
  mensaje_error_vector String?       @db.Text
  // Efecto visual tipo bordado (textura de hilo + brillo satinado) sobre
  // ruta_original -- filtro estético, no digitalizado real de máquina
  // bordadora. Antes vivía en Imagen; se movió acá porque conceptualmente
  // es parte del flujo DTF UV, no de la subida de imágenes genérica. Mismo
  // patrón que estado_capas: opt-in, con un nivel de deshacer.
  estado_bordado       EstadoProceso @default(omitido)
  mensaje_error_bordado String?      @db.Text
  ruta_pre_bordado     String?       @db.VarChar(500)
  // Sliders del efecto bordado: separación entre puntadas (más chico = más
  // tupido/denso) y medio-largo de cada puntada.
  bordado_paso_px      Int           @default(6)
  bordado_largo_px     Int           @default(7)
  // Segunda capa de bordado: SOLO el contorno (letras/logo/imágenes), sin
  // rellenar el interior ni el fondo -- pensada como punto de partida para
  // la capa spot blanco (Spot1/Spot2), no necesariamente igual a la capa de
  // bordado general de arriba. Escribe directo a ruta_mascara_blanco.
  contorno_grosor_px          Int           @default(12)
  estado_contorno_bordado     EstadoProceso @default(omitido)
  mensaje_error_contorno_bordado String?    @db.Text
  // Textura generada con Gemini a partir de una instrucción de texto (fondo
  // magenta sólido pedido al modelo, recortado por color después -- ver
  // ai-service/app/procesamiento.py). NO reemplaza ruta_mascara_blanco/
  // barniz directo: es un archivo aparte (PNG con transparencia real, gris
  // = intensidad) que el editor de relieve usa como relleno (canvas
  // pattern) sobre las regiones vectorizadas ya activas -- el hueco
  // transparente de la textura es justo lo que genera la variación de
  // relieve al aplicarla.
  estado_patron_ia     EstadoProceso @default(omitido)
  mensaje_error_patron_ia String?    @db.Text
  ruta_patron_ia       String?       @db.VarChar(500)
  // Sliders de la propuesta automática de capas (CONTEXTO.md-style: ver plan).
  grosor_relieve_px    Int           @default(6)
  sensibilidad         Int           @default(50)
  // "omitido" y no "pendiente": a diferencia del vectorizado (que arranca
  // solo al subir), esto lo dispara el usuario a mano más tarde -- mismo
  // criterio que Imagen.estado_upscale/estado_bordado.
  estado_capas         EstadoProceso @default(omitido)
  mensaje_error_capas  String?       @db.Text
  // Nacen como copia de la propuesta automática; a partir de ahí el usuario
  // las edita a mano en el editor de pintura/borrado (Fase 4 del plan).
  ruta_mascara_blanco  String?       @db.VarChar(500)
  ruta_mascara_barniz  String?       @db.VarChar(500)
  // Un nivel de deshacer para cualquiera de las 3 formas de poblar estas dos
  // rutas (contorno de bordado, patrón IA, o guardado manual del editor) --
  // se pisa con el valor ANTERIOR justo antes de cada sobreescritura, sin
  // importar cuál de las 3 lo generó. Mismo criterio que ruta_pre_upscale.
  ruta_pre_mascara_blanco String?    @db.VarChar(500)
  ruta_pre_mascara_barniz String?    @db.VarChar(500)
  ancho_mm             Decimal?      @db.Decimal(8, 2)
  alto_mm              Decimal?      @db.Decimal(8, 2)
  estado_export        EstadoProceso @default(omitido) // mismo criterio que estado_capas
  mensaje_error_export String?       @db.Text
  ruta_export_pdf      String?       @db.VarChar(500) // separaciones spot reales (/Separation)
  ruta_export_tiff     String?       @db.VarChar(500) // CMYK + 4 canales spot nombrados (formato real de producción)
  // Hoja con copias + marcas de registro + contorno de corte, para el
  // plotter de corte (Graphtec/ARMS) -- entregable APARTE de
  // ruta_export_pdf (que es el diseño suelto, sin marcas). copias=null
  // significa que todavía no se armó ninguna hoja.
  copias               Int?
  ancho_hoja_mm        Decimal?      @db.Decimal(8, 2) // preset de rollo, mismo set que Lienzo tipo:dtf
  margen_hoja_mm       Decimal       @default(5) @db.Decimal(6, 2) // margen de hoja Y separación entre copias
  marca_registro_mm    Decimal       @default(10) @db.Decimal(6, 2) // tamaño de marca ARMS -- ajustable, confirmar contra el plotter real
  rotar_copias         Boolean       @default(false) // gira cada copia 90° en la grilla -- útil cuando el diseño entra más veces por fila así
  alto_hoja_mm         Decimal?      @db.Decimal(10, 2) // calculado por "armar hoja"
  estado_hoja          EstadoProceso @default(omitido)
  mensaje_error_hoja   String?       @db.Text
  ruta_hoja_pdf        String?       @db.VarChar(500)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt
  proyecto             Proyecto      @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)

  @@map("dtf_uv")
}

// Agente de escritorio instalado en la PC de producción de cada empresa.
// Se identifica con un token propio de 19print (no con el id_empresa, que no
// es secreto): el agente manda el token, acá se resuelve a qué empresa
// corresponde y de ahí en adelante todo el filtrado usa id_empresa_ninesys,
// igual que el resto del backend.
//
// El token vive acá y NO en `empresas` de api_empresas a propósito: esa
// tabla guarda credenciales que ninesys-api necesita para llamar HACIA
// AFUERA (ws_token/ws_username son para el servicio de WhatsApp, ver
// ninesys-api/app/lib/whatsapp.php). Este token va en la dirección opuesta
// -- la PC se lo presenta a ESTE backend, que es quien lo valida -- así que
// le corresponde vivir en la base de quien lo valida.
model EmpresaAgente {
  id                 Int       @id @default(autoincrement())
  id_empresa_ninesys Int       @unique
  nombre             String    @db.VarChar(100)
  // sha256 del token, nunca el token en claro: permite buscarlo en O(1) y
  // que una filtración de la DB no entregue credenciales usables. Se muestra
  // una sola vez al generarlo; si se pierde, se regenera.
  token_hash         String?   @unique @db.VarChar(64)
  activo             Boolean   @default(true)
  ultimo_ping        DateTime?
  version_agente     String?   @db.VarChar(20)
  created_at         DateTime  @default(now())
  entregas           EntregaLienzo[]

  @@map("empresa_agentes")
}

// Un lienzo pendiente de bajar a la PC de una empresa. Se crea al confirmar
// el pedido (que es cuando recién se sabe a qué empresa le toca imprimir,
// ver routes/ninesys.js) y la cola se acumula sola si la PC está apagada.
model EntregaLienzo {
  id                Int           @id @default(autoincrement())
  lienzo_id         Int           @unique
  empresa_agente_id Int
  estado            EstadoEntrega @default(pendiente)
  intentos          Int           @default(0)
  ultimo_error      String?       @db.Text
  entregado_en      DateTime?
  // Cuándo se borró el export del VPS tras cumplirse la retención. El
  // lienzo siempre se puede regenerar desde el diseño, así que purgar no
  // pierde información.
  purgado_en        DateTime?
  created_at        DateTime      @default(now())
  lienzo            Lienzo        @relation(fields: [lienzo_id], references: [id], onDelete: Cascade)
  empresa_agente    EmpresaAgente @relation(fields: [empresa_agente_id], references: [id])

  @@index([empresa_agente_id, estado])
  @@map("entregas_lienzo")
}

// Curaduría de admin sobre el catálogo de Ninesys: GET /products trae TODO
// lo que esa empresa marcó como es_servicio_de_impresion, que puede incluir
// productos que no tienen sentido para armar un lienzo acá. Presencia =
// visible en el selector de servicio del pedido (routes/ninesys.js filtra
// por esta tabla); sin fila para un `cod` dado, no se muestra -- opt-in a
// propósito, no opt-out, para que un producto nuevo en Ninesys no aparezca
// solo hasta que un admin lo revise.
//
// `precio` es el que el admin eligió entre los tramos que trae Ninesys
// (products_prices no tiene min/max estructurado, ver ninesysApi.js) -- se
// fija una sola vez acá para que quien pide el presupuesto nunca tenga que
// ver ni elegir entre tramos de precio, solo el nombre del servicio.
model ServicioNinesysVisible {
  id                 Int      @id @default(autoincrement())
  id_empresa_ninesys Int
  // Código de producto de Ninesys (products.cod), no un id propio de esta
  // app -- es lo único estable que ninesys-api expone para identificarlo.
  cod                String   @db.VarChar(64)
  precio             Decimal  @db.Decimal(10, 2)
  created_at         DateTime @default(now())

  @@unique([id_empresa_ninesys, cod])
  @@map("servicios_ninesys_visibles")
}
